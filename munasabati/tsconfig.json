{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@munasabati/core": ["packages/core/src/index.ts"],
      "@munasabati/ui": ["packages/ui/src/index.ts"],
      "@munasabati/cloud": ["packages/cloud/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src"]
}
